# Production API and Socket.IO base URL (do not add /api)
VITE_API_URL=https://your-backend.onrender.com

# Backend URL used by the Vite development proxy
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional TURN server (needed when people are behind strict firewalls / mobile networks)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
